# ygopro-mcp environment variables
#
# Only the variables marked [bridge] are read by this package's runtime (mcp-server.mjs,
# policy-semantic.mjs). Everything under [client] belongs to the instrumented YGOPro client and is
# set in the shell/launcher that starts the client, NOT in the bridge process.
# Verify any name with: grep -R "process.env.<NAME>" bridge/*.mjs  /  grep -R "getenv(\"<NAME>\")" mycard-client/gframe

# ---------------------------------------------------------------- [bridge] MCP server
# Control API base URL. 房主 7788 / 客机 7789.
CONTROL_URL=http://127.0.0.1:7788

# ---------------------------------------------------------------- [bridge] policy-semantic.mjs
# 单局时长上限（分钟）
MAX_MINUTES=15
# 无新 prompt 多久判定"卡住"并输出诊断（毫秒）
STALL_MS=20000
# 连续多少次空 /actions 之后报一次诊断
EMPTY_ACTIONS_LIMIT=5
# 心跳日志间隔（毫秒）
HEARTBEAT_MS=30000
# /wait_prompt 长轮询超时（毫秒）
WAIT_TIMEOUT_MS=15000
# /act_id 返回 ok:false 时的重试次数
ACT_RETRIES=1
# 诊断块的最小间隔（毫秒）
DIAG_EVERY_MS=30000
# 同一个 curMsg 重复多少次后换一个答案（防 RETRY 死循环）
ESCALATE_AFTER=3
# 优先发动/盖放/连锁三张目标陷阱（1=开，0=关）
TRAP_GOAL=1
# 先/后攻选择（客户端提供 kind:"tp" 动作时生效）：first=先攻（默认）/ second=后攻
TP_PREF=first
# 安全守卫：连续 N 次动作对局毫无变化 -> STALL HARD 并 exit 2
MAX_IDLE_ACTIONS=5
# 保留字段：MISSION（同调/超量演示模式开关，0=关）
MISSION=0

# ---------------------------------------------------------------- [ops] get-room.mjs
# 排位取房时锁定的账号 id（仅运维脚本使用；不要提交真实值）
# MC_ACCOUNT_ID=

# ================================================================ [client] 由客户端读取（不是在 bridge 里设）
# 控制层 HTTP 端口（房主 7788 / 客机 7789）
# YGO_CONTROL_PORT=7788
# hooks mask：msg=1 analyze=2 stoc=4 all=7（房主用 msganalyze，客机可用 all）
# YGO_HOOKS=msganalyze
# 连锁时点：all|avail|ignore
# YGO_CHAIN_MODE=avail
# 选格坐标口径：server|local
# YGO_PLACE_COORDS=server
# 自动关闭 MSG_RETRY/提示框（1=开）
# YGO_AUTO_DISMISS=1
# 猜拳 / 先后手（不设则随机 / 默认后手）
# YGO_RPS=2
# YGO_TP=2
# UI 注入系列
# YGO_UI_ACTIONS=1
# YGO_UI_EVENT_DIRECT=0
# YGO_UI_HIDE_EXTRA=1
# YGO_UI_CLOSE_EMPTY=1
# 控制层 debug 日志（窗口列表等，日志量很大）
# YGO_CTRL_DEBUG=
# journal / 断线处理
# YGO_RESUME_JOURNAL=
# YGO_RESUME_PATH=
# YGO_SUPPRESS_MODALS=1
# /net 探活参数
# YGO_NET_PROBE=1
# YGO_NET_IDLE_MS=2500
# YGO_NET_PROBE_GAP_MS=3000
# YGO_NET_PROBE_WINDOW_MS=1500
# YGO_NET_DEAD_SILENCE_MS=10000
# YGO_NET_PROBE_REQUIRE_SYSTEM=1

# ================================================================ CLI-only（不是环境变量，避免误用）
# supervisor.mjs : --profile lan|ranked --port 7788 --client <exe> --join-ip/--join-port/--join-pass ...
# netfault.mjs   : --listen 7912 --upstream 127.0.0.1:7911 --ctrl 7913
# net-probe.mjs  : --port 7789 --interval 500 --duration 60000 --csv out.csv
# doctor.mjs     : --port 7789 --client <exe> --json
